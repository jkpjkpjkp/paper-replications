{
  "scope": "bounded corrected-code CSI300 execution, not a full paper replication",
  "provider": "../csi/qlib/cn_data",
  "universe": "csi300",
  "device": "cuda",
  "threads": 2,
  "seed": 0,
  "pool": 10,
  "lambda": 1.0,
  "steps": 512,
  "eval_interval": 128,
  "splits": {
    "train": [
      "2010-01-01",
      "2019-12-31"
    ],
    "valid": [
      "2020-01-01",
      "2020-12-31"
    ],
    "test": [
      "2021-01-01",
      "2022-12-31"
    ]
  },
  "hyper_overrides": {
    "start_steps": 16,
    "batch_size": 8,
    "N": 8,
    "N_dash": 8,
    "K": 8,
    "target_update_interval": 32
  }
}
